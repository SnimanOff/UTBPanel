# Copy to .env and edit.

# Domain or IP of the server: used in webhook URLs and by gate.exe.
PUBLIC_ADDR=203.0.113.10
# Domain for a Let's Encrypt certificate on :8443; empty = self-signed.
DOMAIN=

# Each service is updated on its own.
EDGE_VERSION=latest
CORE_VERSION=latest
PANEL_VERSION=latest

LOG_LEVEL=info
