# Copy to .env and edit.

# Domain or IP of the server: used in webhook URLs and by gate.exe.
# With DOMAIN set it must be the same domain name: Telegram reaches the
# webhook by this name, and the certificate is issued for DOMAIN.
PUBLIC_ADDR=203.0.113.10
# Domain for a Let's Encrypt certificate on :8443 and for passkey sign-in;
# empty = self-signed, no sign-in from phones.
DOMAIN=
# Optional contact address for ACME account registration.
# ACME_EMAIL=
# Use Let's Encrypt staging with its own rate limits and cache.
# Test clients must explicitly trust the staging CA.
# ACME_STAGING=false
# Port for passkey sign-in from phones (only with DOMAIN).
WEB_PORT=9443

# Each service is updated on its own.
EDGE_VERSION=latest
CORE_VERSION=latest
PANEL_VERSION=latest

LOG_LEVEL=info
